{
  "name": "llama.cpp Server",
  "category": "llm",
  "deployment_id": "llama-cpp",
  "version": "1.0.0",
  "platform": {
    "engine": "llama-cpp",
    "default_enabled": false,
    "adapter": "adapter.mjs",
    "runtime": {
      "id": "llama-cpp",
      "name": "llama.cpp",
      "driver": "process",
      "command": "llama-server",
      "args": ["--host", "127.0.0.1", "--port", "18080"],
      "port": 18080,
      "concurrency": 2,
      "health_path": "/health"
    },
    "resources": {
      "backends": ["cuda", "rocm", "metal", "vulkan", "cpu"],
      "gpu_count": 1,
      "vram_mb": 4096,
      "vram_mode": "shared",
      "concurrency": 2,
      "affinity": "any",
      "cold_start_weight": "low"
    },
    "ui": {
      "name": "llama.cpp",
      "version": "GGUF",
      "full_name": "llama.cpp · GGUF Server",
      "description": "Cross-platform native GGUF inference via CUDA, ROCm, Metal, Vulkan, or CPU",
      "kind": "Language",
      "accent": "#6ee7b7",
      "symbol": "L",
      "panel": "llm",
      "log_name": "llama-server"
    },
    "models": []
  }
}
